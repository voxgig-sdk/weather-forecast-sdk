# Entity: weather

main: kit: entity: weather: {

  alias: field: {}

  fields: [
    {
      name: "conditions"
      req: false
      short: "Expected weather conditions"
      type: "`$STRING`"
    }
    {
      format: "date"
      name: "date"
      req: false
      short: "Forecast date"
      type: "`$STRING`"
    }
    {
      format: "double"
      name: "humidity"
      req: false
      short: "Average humidity percentage"
      type: "`$NUMBER`"
    }
    {
      format: "double"
      name: "precipitation_chance"
      req: false
      short: "Probability of precipitation (0-100)"
      type: "`$NUMBER`"
    }
    {
      format: "double"
      name: "temperature_high"
      req: false
      short: "High temperature for the day"
      type: "`$NUMBER`"
    }
    {
      format: "double"
      name: "temperature_low"
      req: false
      short: "Low temperature for the day"
      type: "`$NUMBER`"
    }
  ]

  name: "weather"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 5
                kind: "query"
                name: "day"
                orig: "day"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: "Paris"
                kind: "query"
                name: "location"
                orig: "location"
                reqd: true
                type: "`$STRING`"
              }
              {
                example: "metric"
                kind: "query"
                name: "unit"
                orig: "unit"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/weather"
          segments: [
            {
              lit: "weather"
            }
          ]
          select: {
            exist: [
              "day"
              "location"
              "unit"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
